(set-logic QF_AUFNIA)
(set-info :status sat)
(declare-fun i () Int)
(declare-fun j () Int)
(declare-fun k () Int)
(declare-fun a () (Array Int Int))
(declare-fun b () (Array Int Int))
(declare-fun c () (Array Int Int))
(declare-fun f (Int) Int)
(declare-fun g ((Array Int Int)) Int)
(declare-fun h ((Array Int Int)) Bool)
(assert (= k (g (store c k j))))
(assert (distinct a (store (store c 2 (- 1 j)) (- 1 (g b)) (select c (g c)))))
(assert (<= (+ (+ (- 1) 2) 1) 5))
(assert (< (select (store a 0 j) (select c (- 1))) i))
(assert (not (= a (store a 1 j))))
(check-sat)
