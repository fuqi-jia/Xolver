(set-logic QF_AUFNIA)
(set-info :status sat)
(declare-fun i () Int)
(declare-fun j () Int)
(declare-fun k () Int)
(declare-fun a () (Array Int Int))
(declare-fun b () (Array Int Int))
(declare-fun c () (Array Int Int))
(declare-fun f (Int) Int)
(declare-fun g ((Array Int Int)) Int)
(declare-fun h ((Array Int Int)) Bool)
(assert (not (distinct (store b (f i) (f i)) (store a (+ (+ k 5) (g c)) (select (store b 1 k) k)))))
(assert (<= k 1))
(assert (= a (store b 2 0)))
(assert (= c a))
(assert (not (<= (select (store b k (- k k)) i) (- 1))))
(check-sat)
