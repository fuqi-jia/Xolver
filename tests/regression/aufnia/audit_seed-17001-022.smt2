(set-logic QF_AUFNIA)
(set-info :status sat)
(declare-fun i () Int)
(declare-fun j () Int)
(declare-fun k () Int)
(declare-fun a () (Array Int Int))
(declare-fun b () (Array Int Int))
(declare-fun c () (Array Int Int))
(declare-fun f (Int) Int)
(declare-fun g ((Array Int Int)) Int)
(declare-fun h ((Array Int Int)) Bool)
(assert (<= k 2))
(assert (= (- 1) (g (store b (- 1) (g a)))))
(assert (<= (select c k) (g c)))
(assert (not (distinct (+ j (f (f j))) (- (select (store c i 1) (g c)) i))))
(assert (distinct (+ (f i) (g b)) (+ (select b 0) (- (- 1) 1))))
(assert (not (distinct (store c 2 (- 1 (g c))) a)))
(check-sat)
