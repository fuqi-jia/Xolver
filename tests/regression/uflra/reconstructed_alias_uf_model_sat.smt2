; Real aliases reconstructed from typed values must agree with printed classes.
(set-option :produce-models true)
(set-logic QF_UFLRA)
(set-info :status sat)
(declare-const x Real)
(declare-const padding Real)
(declare-const alias Real)
(declare-fun f (Real) Real)
(declare-fun g (Real) Real)
(assert (= alias x))
(assert (distinct (f x) (f 0)))
(assert (> (g padding) 9))
(check-sat)
(get-model)
