(set-logic QF_NRA)
(set-info :status sat)
(declare-const a Real)
(declare-const b Real)
(declare-const c Real)
(declare-const w Real)
(assert (and (<= 0 a) (<= a 1) (<= 0 b) (<= b 1) (<= 0 c) (<= c 1)))
(assert (= (+ a b) 1))
(assert (= (* a b) 0))
(assert (= (* a c) 0))
(assert (= (* b c) 1))
(assert (>= w (+ b 1000)))
(check-sat)
