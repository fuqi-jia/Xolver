(set-logic QF_NRA)
(set-info :status unsat)
(declare-const x Real)
(declare-const t Real)
(declare-const a Real)
(declare-const b Real)
(declare-const c Real)
(assert (>= t 1))
(assert (>= a 0))
(assert (>= c 0))
(assert (<= (* b b) (* a c)))
; A semidefinite quadratic plus a nonnegative multiple of its determinant.
(assert (let ((s (+ t 1)))
 (let ((s2 (* s s)) (s3 (* s s s)))
  (let ((s6 (* s3 s3)))
   (< (+ (* a s6 x x) (* c s2)
         (* s3 (- (* a c) (* b b)))
         (- (* 2 s2 s2 b x))) 0)))))
(check-sat)
