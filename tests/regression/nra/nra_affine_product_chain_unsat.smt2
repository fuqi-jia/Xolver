(set-logic QF_NRA)
(set-info :status unsat)
(declare-fun a0 () Real)
(declare-fun a1 () Real)
(declare-fun a2 () Real)
(declare-fun b0 () Real)
(declare-fun b1 () Real)
(declare-fun b2 () Real)
(declare-fun l0 () Real)
(declare-fun l1 () Real)
(declare-fun l2 () Real)
(declare-fun n0 () Real)
(declare-fun n1 () Real)
(assert (= (+ (* a0 l0) (* a1 n0)) a0))
(assert (= (* b0 l0) (+ b0 a0)))
(assert (= (+ (* a1 l1) (* a2 n1)) a1))
(assert (= (* b1 l1) (+ b1 a1)))
(assert (= (* a2 l2) a2))
(assert (= (* b2 l2) (+ b2 a2)))
(assert (= (+ a0 a1 a2) 1))
(check-sat)
