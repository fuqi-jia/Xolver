(set-logic QF_NRA)
(set-info :status unsat)
(declare-const x Real)
(declare-const b Real)
(declare-const k Real)
(declare-const t Real)
(declare-const n Real)
(declare-const u Real)
(declare-const q Real)
(declare-const a Real)
(declare-const z Real)
(declare-const w Real)
(assert (and (>= x 0) (>= b 0) (>= k 0) (>= t 0) (>= n 0)
             (>= u 0) (>= q 0) (>= a 0) (>= z 0) (>= w 0)))
(assert (= (* (- b 1) x) 0))
(assert (>= (* b (- n 1)) 0))
(assert (>= (* b n (- 1 k)) 0))
(assert (>= (* x (- k 1)) 0))
(assert (>= (* b (- z (* z k) t)) 0))
(assert (>= (* b (- (* q a) (* q k))) 0))
(assert (>= (* b (+ z (- (* z k)) (* w q) (- u))) 0))
(assert (>= (- z (* z a) (* q x)) 0))
(assert (> (- (+ (* u x) (* u t x)) (* z t)) 0))
(check-sat)
