(set-logic QF_LRA)
(set-info :status sat)
(set-option :produce-models true)
(declare-const x Real)
(declare-const y Real)
(declare-const z Real)
(assert (= (+ x y z) 0))
(assert (< (- 1) x))
(assert (< x 1))
(assert (< (- 1) y))
(assert (< y 1))
(assert (< (- 1) z))
(assert (< z 1))
(assert (distinct x 0))
(assert (distinct y 0))
(assert (distinct z 0))
(assert (distinct x y))
(assert (distinct y z))
(assert (distinct x z))
(check-sat)
(get-model)
