(set-logic ALL)
(set-info :status unsat)
(declare-heap (Int Int))
(declare-const x Int)
(declare-const y Int)
(declare-const p Bool)
(assert (= (as sep.nil Int) 0))
(assert (= x 3))
(assert (= y 2))
(assert (= p false))
(assert (and (pto (+ x 2) (mod (+ x y) (- 2)))
             (pto (+ y 2) (mod (+ x y) (- 2)))))
(check-sat)
