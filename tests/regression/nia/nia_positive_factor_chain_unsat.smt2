(set-logic QF_NIA)
(set-info :status unsat)
(declare-const x Int)
(declare-const b Int)
(declare-const k Int)
(declare-const t Int)
(declare-const n Int)
(declare-const u Int)
(declare-const q Int)
(declare-const a Int)
(declare-const z Int)
(declare-const w Int)
(assert (and (>= x 0) (>= b 0) (>= k 0) (>= t 0) (>= n 0)
             (>= u 0) (>= q 0) (>= a 0) (>= z 0) (>= w 0)))
(assert (= (* (- b 1) x) 0))
(assert (>= (* b (- n 1)) 0))
(assert (>= (* b n (- 1 k)) 0))
(assert (>= (* x (- k 1)) 0))
(assert (>= (* b (- z (* z k) t)) 0))
(assert (>= (* b (- (* q a) (* q k))) 0))
(assert (>= (* b (+ z (- (* z k)) (* w q) (- u))) 0))
(assert (>= (- z (* z a) (* q x)) 0))
(assert (> (- (+ (* u x) (* u t x)) (* z t)) 0))
(check-sat)
