; Numeric aliases and UF argument classes must use one concrete interpretation.
(set-option :produce-models true)
(set-logic QF_UFLIA)
(set-info :status sat)
(declare-const padding Int)
(declare-const x Int)
(declare-const alias Int)
(declare-fun f (Int) Int)
(declare-fun g (Int) Int)
(assert (= alias x))
(assert (distinct (f x) (f 0)))
(assert (> (g padding) 9))
(check-sat)
(get-model)
