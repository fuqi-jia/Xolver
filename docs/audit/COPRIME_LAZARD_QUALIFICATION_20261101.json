    "record_sha256": "a7a178d8ab1dc82fe24c2716ba274a1397260e438a0d51c6348b205c877dfc5d",
    "source": "#include \"search/nra/cac/CacEngine.h\"\n#include \"search/nra/backend/LibpolyBackend.h\"\n#include \"algebra/poly/PolynomialKernel.h\"\n#include <iostream>\nusing namespace xolver;\nint main() {\n    for (int lower : {1, 3}) {\n        auto kernel = createPolynomialKernel();\n        LibpolyBackend backend(kernel.get());\n        const VarId b = kernel->getOrCreateVar(\"b\"), c = kernel->getOrCreateVar(\"c\");\n        const VarId x = kernel->getOrCreateVar(\"x\");\n        const auto bv = RationalPolynomial::fromVar(b, 1, 1);\n        const auto cv = RationalPolynomial::fromVar(c, 1, 1);\n        const auto xv = RationalPolynomial::fromVar(x, 1, 1);\n        const auto k = [](int n) { return RationalPolynomial::fromConstant(mpq_class(n)); };\n        CacEngine::Config config; config.deadlineMillis = 2000;\n        CacEngine engine(&backend, kernel.get(), {b,c,x}, {\n            {bv+k(-lower),Relation::Geq},{bv+k(-lower-1),Relation::Leq},\n            {cv+k(-lower),Relation::Geq},{cv+k(-lower-1),Relation::Leq},\n            {xv*(xv-bv),Relation::Lt},{xv*(xv-cv),Relation::Gt}}, config);\n        const auto result = engine.solve();\n        if (result.status != CacStatus::Sat) return 2;\n        if (result.model.varOrder.size() != 3) return 3;\n        for (size_t i=0;i<result.model.varOrder.size();++i) {\n            if (!result.model.values[i].isRational()) return 4;\n            std::cout << lower << ' ' << kernel->varName(result.model.varOrder[i])\n                      << ' ' << result.model.values[i].rational.get_str() << '\\n';\n        }\n    }\n}\n"
  },
