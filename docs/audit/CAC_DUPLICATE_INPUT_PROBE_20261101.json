  "observer_source": "#include \"search/nra/cac/SingleCellProjection.h\"\n#include <chrono>\n#include <cstdlib>\n#include <fstream>\n#include <string>\n#include <unordered_set>\nusing namespace xolver;\nextern \"C\" CharacterizationResult realCharacterize(const std::vector<RationalPolynomial>&,\n    VarId, PolynomialKernel*, const SamplePoint*) asm(\"__real__ZN6xolver12characterizeERKSt6vectorINS_18RationalPolynomialESaIS1_EEjPNS_16PolynomialKernelEPKNS_11SamplePointE\");\nextern \"C\" CharacterizationResult observeCharacterize(const std::vector<RationalPolynomial>&,\n    VarId, PolynomialKernel*, const SamplePoint*) asm(\"__wrap__ZN6xolver12characterizeERKSt6vectorINS_18RationalPolynomialESaIS1_EEjPNS_16PolynomialKernelEPKNS_11SamplePointE\");\nextern \"C\" CharacterizationResult observeCharacterize(const std::vector<RationalPolynomial>& input,\n        VarId variable, PolynomialKernel* kernel, const SamplePoint* sample) {\n    static unsigned long long calls = 0;\n    const auto call = ++calls;\n    const auto start = std::chrono::steady_clock::now();\n    std::unordered_set<std::string> keys;\n    size_t projected = 0, terms = 0;\n    for (auto p : input) {\n        p.normalize();\n        if (p.isZero() || p.isConstant() || p.degree(variable) < 1) continue;\n        ++projected;\n        terms += p.terms().size();\n        const mpq_class leading = p.terms().rbegin()->second;\n        if (leading != 1) { p *= mpq_class(1) / leading; p.normalize(); }\n        std::string key;\n        for (const auto& [monomial, coefficient] : p.terms()) {\n            key += coefficient.get_str() + \":\";\n            for (const auto& [v, exponent] : monomial)\n                key += std::to_string(v) + \"^\" + std::to_string(exponent) + \";\";\n            key += \"|\";\n        }\n        keys.insert(std::move(key));\n    }\n    const auto before = std::chrono::steady_clock::now();\n    const char* destination = std::getenv(\"ARITH_STAGE_PROF\");\n    auto emit = [&](const std::string& phase, long long microseconds, int complete) {\n        if (!destination) return;\n        std::ofstream log(std::string(destination) + \".characterize.jsonl\", std::ios::app);\n        log << \"{\\\"phase\\\":\\\"\" << phase << \"\\\",\\\"call\\\":\" << call\n            << \",\\\"variable\\\":\" << variable << \",\\\"inputs\\\":\" << input.size()\n            << \",\\\"projected_inputs\\\":\" << projected << \",\\\"unique_units\\\":\" << keys.size()\n            << \",\\\"terms\\\":\" << terms << \",\\\"microseconds\\\":\" << microseconds\n            << \",\\\"complete\\\":\" << complete << \"}\\n\";\n    };\n    emit(\"entry\", std::chrono::duration_cast<std::chrono::microseconds>(before-start).count(), -1);\n    auto result = realCharacterize(input, variable, kernel, sample);\n    emit(\"return\", std::chrono::duration_cast<std::chrono::microseconds>(\n        std::chrono::steady_clock::now()-before).count(), result.complete);\n    return result;\n}\n",
