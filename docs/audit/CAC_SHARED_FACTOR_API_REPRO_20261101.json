    "boundary": "Constructed shared-factor correctness diagnosis, not a performance score. All four direct CAC inputs are SAT; b=lower+1,c=lower,x=lower+1/2 is a witness. Independent Z3/cvc5 check original and grounded formulas. Direct engine and frozen CLI outcomes are reported separately. No canonical source, core archive or unit binary changes; no header/object ABI mixing."
  },
  "source": "#include \"search/nra/cac/CacEngine.h\"\n#include \"search/nra/cac/SingleCellProjection.h\"\n#include \"search/nra/backend/LibpolyBackend.h\"\n#include \"algebra/poly/PolynomialKernel.h\"\n#include <iostream>\nusing namespace xolver;\n\nstatic const char* status(CacStatus s) {\n    return s == CacStatus::Sat ? \"sat\" : s == CacStatus::Unsat ? \"unsat\" : \"unknown\";\n}\nstatic RationalPolynomial linear(VarId v, int constant) {\n    auto p = RationalPolynomial::fromVar(v, 1, 1);\n    p.addConstant(constant); p.normalize(); return p;\n}\nint main() {\n    for (int lower : {1, 3}) {\n        for (bool explicitOrder : {false, true}) {\n            auto kernel = createPolynomialKernel();\n            LibpolyBackend backend(kernel.get());\n            const VarId b = kernel->getOrCreateVar(\"b\");\n            const VarId c = kernel->getOrCreateVar(\"c\");\n            const VarId x = kernel->getOrCreateVar(\"x\");\n            const auto xx = RationalPolynomial::fromVar(x, 1, 1);\n            auto p = xx * (xx - RationalPolynomial::fromVar(b, 1, 1));\n            auto q = xx * (xx - RationalPolynomial::fromVar(c, 1, 1));\n            p.normalize(); q.normalize();\n            std::vector<CacConstraint> constraints{\n                {linear(b, -lower), Relation::Geq},\n                {linear(b, -lower-1), Relation::Leq},\n                {linear(c, -lower), Relation::Geq},\n                {linear(c, -lower-1), Relation::Leq},\n                {p, Relation::Lt}, {q, Relation::Gt}};\n            if (explicitOrder) {\n                auto order = RationalPolynomial::fromVar(b, 1, 1)\n                    - RationalPolynomial::fromVar(c, 1, 1);\n                order.normalize();\n                constraints.push_back({order, Relation::Gt});\n            }\n            CacEngine::Config cfg; cfg.deadlineMillis = 2000;\n            CacEngine engine(&backend, kernel.get(), {b, c, x}, constraints, cfg);\n            const auto result = engine.solve();\n            std::cout << \"range_\" << lower << \"_order_\" << explicitOrder << ' '\n                      << status(result.status) << ' ' << engine.lastUnknown() << '\\n';\n        }\n    }\n    auto kernel = createPolynomialKernel();\n    const VarId b = kernel->getOrCreateVar(\"b\"), c = kernel->getOrCreateVar(\"c\");\n    const VarId x = kernel->getOrCreateVar(\"x\");\n    const auto xx = RationalPolynomial::fromVar(x, 1, 1);\n    auto p = xx * (xx - RationalPolynomial::fromVar(b, 1, 1));\n    auto q = xx * (xx - RationalPolynomial::fromVar(c, 1, 1));\n    p.normalize(); q.normalize();\n    SamplePoint prefix;\n    prefix.push(b, RealAlg::fromRational(mpq_class(3)));\n    prefix.push(c, RealAlg::fromRational(mpq_class(3)));\n    const auto projected = characterize({p, q}, x, kernel.get(), &prefix);\n    size_t vanishing = 0;\n    for (const auto& polynomial : projected.downwardPolys)\n        vanishing += polynomial.evaluateRational({{b, 3}, {c, 3}}) == 0;\n    std::cout << \"projection_complete \" << projected.complete << '\\n';\n    std::cout << \"projection_size \" << projected.downwardPolys.size() << '\\n';\n    std::cout << \"vanishing_at_equal_positive \" << vanishing << '\\n';\n}\n",
